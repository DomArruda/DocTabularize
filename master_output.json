@contextmanager
def open_pdf(path: str):
    """Context manager ensuring fitz Document is properly closed."""
    doc = fitz.open(path)
    try:
        yield doc
    finally:
        doc.close()
        log.debug("[INGEST] PDF document closed.")


def ingest_document(path: str) -> List[Chunk]:
    """Ingest a PDF or text file, returning Chunk objects."""
    p = Path(path)
    if not p.exists():
        raise FileNotFoundError(f"Target process file does not exist: {p.absolute()}")

    log.info("[INGEST] Ingesting document: %s", p.name)
    if p.suffix.lower() == ".pdf":
        try:
            with open_pdf(path) as doc:
                chunks = []
                for page_num in range(len(doc)):
                    try:
                        text = doc[page_num].get_text("text").strip()
                        if len(text) < 15:
                            log.debug("  Skipping page %d: insufficient text (%d chars)", page_num, len(text))
                            continue
                        chunks.append(Chunk(chunk_id=len(chunks), page_num=page_num, text=text, source=path))
                    except Exception as e:
                        log.error("  [FAIL] Error extracting text from page %d: %s", page_num, e)
                        log.error(traceback.format_exc())
                log.info("  [OK] Ingested %d pages from PDF.", len(chunks))
                return chunks
        except Exception as e:
            log.error("  [FAIL] Fatal error opening PDF: %s", e)
            raise
    else:
        try:
            text = p.read_text(encoding="utf-8")
            words = text.split()
            chunks = [Chunk(chunk_id=i, page_num=i, text=" ".join(words[i:i+400]), source=path)
                      for i in range(0, len(words), 400)]
            log.info("  [OK] Ingested %d chunks from text file.", len(chunks))
            return chunks
        except Exception as e:
            log.error("  [FAIL] Error reading text file: %s", e)
            raise


def execute_embedding_generation(chunks: List[Chunk], model_name: str) -> List[Chunk]:
    """Generate embeddings for all chunks."""
    log.info("[EMBED] Generating embeddings...")
    try:
        model = SentenceTransformer(model_name)
        embeddings = model.encode([c.text for c in chunks], show_progress_bar=False, batch_size=32)
        for chunk, emb in zip(chunks, embeddings):
            chunk.embedding = emb
        log.info("  [OK] Generated %d embeddings (dim=%d).", len(embeddings), embeddings.shape[1])
        return chunks
    except Exception as e:
        log.error("  [FAIL] Embedding generation failed: %s", e)
        log.error(traceback.format_exc())
        raise


def run_manifold_reduction(chunks: List[Chunk], cfg: ResolvedClusterConfig) -> List[Chunk]:
    """Reduce embeddings to lower-dimensional manifold."""
    log.info("[UMAP] Running UMAP manifold reduction...")
    try:
        matrix = np.vstack([c.embedding for c in chunks])
        reducer = umap.UMAP(
            n_components=cfg.umap_components, n_neighbors=cfg.umap_neighbors,
            min_dist=cfg.umap_min_dist, metric="cosine", random_state=42
        )
        coords_matrix = reducer.fit_transform(matrix)
        for chunk, coords in zip(chunks, coords_matrix):
            chunk.umap_coords = coords
        log.info("  [OK] Reduced to %d dimensions.", cfg.umap_components)
        return chunks
    except Exception as e:
        log.error("  [FAIL] UMAP reduction failed: %s", e)
        log.error(traceback.format_exc())
        raise


def generate_spatial_density_clusters(chunks: List[Chunk], cfg: ResolvedClusterConfig) -> Dict[int, int]:
    """Cluster chunks using HDBSCAN with per-cluster resolved config."""
    log.info("[CLUSTER] Clustering with HDBSCAN (min_cluster=%d, min_samples=%d)...",
             cfg.hdbscan_min_cluster, cfg.hdbscan_min_samples)
    try:
        matrix = np.vstack([c.umap_coords for c in chunks])
        clusterer = hdbscan.HDBSCAN(
            min_cluster_size=cfg.hdbscan_min_cluster, min_samples=cfg.hdbscan_min_samples,
            metric="euclidean", cluster_selection_method="eom"
        )
        labels = clusterer.fit_predict(matrix)
        stats: Dict[int, int] = {}
        for chunk, label in zip(chunks, labels):
            chunk.cluster_id = int(label)
            stats[int(label)] = stats.get(int(label), 0) + 1

        valid_clusters = {k: v for k, v in stats.items() if k != -1}
        log.info("  [OK] Found %d clusters (+ %d noise points).", len(valid_clusters), stats.get(-1, 0))
        for cid, count in valid_clusters.items():
            log.info("     Cluster %d: %d pages", cid, count)
        return stats
    except Exception as e:
        log.error("  [FAIL] Clustering failed: %s", e)
        log.error(traceback.format_exc())
        raise


def isolate_medoid_samples(chunks: List[Chunk], cfg: ResolvedClusterConfig) -> Dict[int, List[Chunk]]:
    """Select medoid (central) samples from each cluster using FAISS."""
    log.info("[MEDOID] Selecting medoid samples...")
    samples = {}
    valid_cids = sorted(set(c.cluster_id for c in chunks if c.cluster_id != -1))
    for cid in valid_cids:
        try:
            members = [c for c in chunks if c.cluster_id == cid]
            coords = np.vstack([c.umap_coords for c in members]).astype("float32")
            index = faiss.IndexFlatL2(coords.shape[1])
            index.add(coords)
            _, idx = index.search(coords.mean(axis=0, keepdims=True),
                                  min(cfg.samples_per_cluster, len(members)))
            samples[cid] = [members[i] for i in idx[0]]
            log.info("  Cluster %d: selected %d medoid samples.", cid, len(samples[cid]))
        except Exception as e:
            log.error("  [FAIL] Medoid sampling failed for cluster %d: %s", cid, e)
            log.error(traceback.format_exc())
    return samples


