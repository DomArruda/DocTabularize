class SchemaRegistry:
    """Persistent DuckDB-backed registry for schema performance tracking."""

    def __init__(self, db_path: Path):
        try:
            db_path.parent.mkdir(parents=True, exist_ok=True)
            self.db = duckdb.connect(str(db_path))
            self._init_tables()
            log.info("[REGISTRY] Schema registry initialized at %s", db_path)
        except Exception as e:
            log.error("[FAIL] Failed to initialize schema registry: %s", e)
            raise

    def _init_tables(self):
        self.db.execute("""
            CREATE TABLE IF NOT EXISTS schema_registry (
                schema_id VARCHAR PRIMARY KEY,
                cluster_id INTEGER,
                schema_json JSON,
                granularity VARCHAR,
                avg_extraction_score FLOAT,
                total_rows_extracted INTEGER,
                parent_schema_id VARCHAR,
                run_timestamp TIMESTAMP,
                doc_source VARCHAR,
                survival_generation INTEGER DEFAULT 1
            )
        """)
        self.db.execute("""
            CREATE TABLE IF NOT EXISTS schema_lineage (
                lineage_id VARCHAR PRIMARY KEY,
                ancestor_schema_id VARCHAR,
                descendant_schema_id VARCHAR,
                mutation_description VARCHAR,
                score_delta FLOAT
            )
        """)

    def register_schema(self, schema_id: str, cluster_id: int, schema: ClusterSchema,
                        avg_score: float, total_rows: int, doc_source: str,
                        parent_schema_id: Optional[str] = None):
        try:
            schema_json = schema.model_dump_json()
            self.db.execute("""
                INSERT OR REPLACE INTO schema_registry
                VALUES (?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP, ?,
                    COALESCE((SELECT survival_generation FROM schema_registry WHERE schema_id = ?), 1))
            """, [schema_id, cluster_id, schema_json, schema.granularity,
                  avg_score, total_rows, parent_schema_id, doc_source, schema_id])
            log.info("  [REGISTER] Registered schema %s (score: %.1f)", schema_id, avg_score)
        except Exception as e:
            log.error("  [FAIL] Failed to register schema %s: %s", schema_id, e)

    def get_top_schemas(self, cluster_id: int, top_k: int = 3) -> List[Dict]:
        try:
            result = self.db.execute("""
                SELECT schema_id, schema_json, avg_extraction_score, granularity, survival_generation
                FROM schema_registry
                WHERE cluster_id = ?
                ORDER BY avg_extraction_score DESC
                LIMIT ?
            """, [cluster_id, top_k]).fetchall()

            schemas = []
            for row in result:
                schemas.append({
                    "schema_id": row[0],
                    "schema": json.loads(row[1]),
                    "score": row[2],
                    "granularity": row[3],
                    "generation": row[4]
                })
            return schemas
        except Exception as e:
            log.error("  [FAIL] Failed to retrieve top schemas: %s", e)
            return []

    def generate_schema_id(self, cluster_id: int, parent_id: Optional[str] = None) -> str:
        gen = 1
        if parent_id:
            existing = self.db.execute(
                "SELECT survival_generation FROM schema_registry WHERE schema_id = ?",
                [parent_id]
            ).fetchone()
            if existing:
                gen = existing[0] + 1
        timestamp = datetime.now().strftime("%Y%m%d%H%M%S")
        return f"schema_c{cluster_id}_g{gen}_{timestamp}"


def _convert_config_schema_to_cluster_schema(s_cfg: SchemaLevelConfig) -> ClusterSchema:
    """Convert a SchemaLevelConfig (from TOML) into a ClusterSchema for runtime use."""
    field_defs = {}
    for name, f in s_cfg.fields.items():
        desc = f.type
        if f.description:
            desc += f" | {f.description}"
        if f.validation:
            desc += f" | validation:{f.validation}"
        if f.enum:
            desc += f" | enum:{','.join(f.enum)}"
        if f.min is not None or f.max is not None:
            desc += f" | range:{f.min}-{f.max}"
        field_defs[name] = desc
    return ClusterSchema(
        granularity="config",
        rationale=f"Loaded from hierarchical config schema '{s_cfg.name}'",
        schema_fields=field_defs,
        parent_schema_id=s_cfg.parent_schema_id,
        source="config"
    )


def execute_protected_schema_discovery(
    cluster_id: int,
    sample_chunks: List[Chunk],
    cluster_cfg: ResolvedClusterConfig,
    client: OpenAI,
    cfg: HierarchicalConfig,
    registry: Optional[SchemaRegistry] = None
) -> Tuple[ClusterSchema, Optional[SchemaLevelConfig]]:
    """Discover or load schema for a cluster.

    Returns:
        (ClusterSchema, Optional[SchemaLevelConfig]) — the runtime schema and the 
        original schema-level config (if loaded from TOML) for validation.
    """
    log.info("  [SCHEMA] Resolving schema for cluster %d (%s)...", cluster_id, cluster_cfg.name)

    # 1. Check for predefined schemas in TOML
    predefined = cfg.get_schemas_for_cluster(cluster_id)
    if predefined:
        log.info("  [SCHEMA] Using %d predefined schema(s) from configuration.", len(predefined))
        # Merge all predefined schemas into one runtime schema envelope
        merged_fields = {}
        for s in predefined:
            merged_fields.update(s.fields)
        # Create a synthetic SchemaLevelConfig for validation
        synthetic_schema = SchemaLevelConfig(
            name=f"merged_cluster_{cluster_id}",
            cluster_id=cluster_id,
            fields={k: v for s in predefined for k, v in s.fields.items()},
            validation=predefined[0].validation if predefined else {},
            extraction=predefined[0].extraction if predefined else {}
        )
        return _convert_config_schema_to_cluster_schema(synthetic_schema), synthetic_schema

    # 2. Otherwise, perform LLM-driven discovery with genetic memory
    sample_text = "\n\n---\n\n".join(c.text[:800] for c in sample_chunks)
    error_feedback = ""

    few_shot_text = ""
    parent_schema_id = None
    if cluster_cfg.enable_schema_evolution and registry:
        try:
            top_schemas = registry.get_top_schemas(cluster_id, cluster_cfg.schema_evolution_top_k)
            if top_schemas:
                few_shot_text = "\n\nHISTORICALLY SUCCESSFUL SCHEMAS FOR THIS CLUSTER:\n"
                for i, s in enumerate(top_schemas):
                    few_shot_text += f"\nTop Schema {i+1} (Score: {s['score']:.1f}, Gen {s['generation']}):\n"
                    few_shot_text += json.dumps(s['schema'], indent=2) + "\n"
                parent_schema_id = top_schemas[0]['schema_id'] if top_schemas else None
                log.info("  [DNA] Using %d historical schemas as few-shot examples.", len(top_schemas))
        except Exception as e:
            log.warning("  [WARN] Failed to load historical schemas: %s", e)

    for attempt in range(1, 5):
        prompt = f"""Design a relational flat JSON database schema matching entities across these documents.
SAMPLE METADATA TEXTS:
{sample_text}
{few_shot_text}
TARGET GOAL: Extract roughly {cluster_cfg.target_features} comprehensive schema fields.
CRITICAL: Output structural raw JSON conforming EXACTLY to the following specification.
The 'schema_fields' element MUST be a flat key-value dictionary mapping field name to data type/description string. Do NOT use nested objects or list formats.
If historical schemas are provided above, you may improve upon them (add missing fields, remove noise, adjust types).

{{"granularity": "medium", "rationale": "Explanation of structural alignment", "schema_fields": {{"item_id": "string", "amount": "number"}}}}
{error_feedback}"""

        try:
            log.info("    Schema discovery attempt %d/4...", attempt)
            response = client.chat.completions.create(
                model=cfg.pipeline.models.get("schema_model", "qwen2.5-vl:7b"),
                messages=[{"role": "user", "content": prompt}],
                temperature=0.0,
                timeout=30
            )
            raw_content = _strip_fences(response.choices[0].message.content)
            log.debug("    Raw response: %s...", raw_content[:200])
            schema_dict = json.loads(raw_content)
            schema_dict["parent_schema_id"] = parent_schema_id
            schema_dict["source"] = "discovered"
            schema = ClusterSchema.model_validate(schema_dict)
            log.info("    [OK] Cluster %d schema established on attempt %d.", cluster_id, attempt)
            return schema, None
        except json.JSONDecodeError as e:
            err_trace = f"JSON parse error: {str(e)[:150]}"
            log.warning("    [WARN] Schema JSON parsing failure (Attempt %d): %s", attempt, err_trace)
            error_feedback = f"\n\nPREVIOUS PARSING REJECTION TRACE: {err_trace}\nCRITICAL FIX: Output only valid JSON matching the specification exactly."
        except ValidationError as e:
            err_trace = f"Pydantic validation: {str(e)[:150]}"
            log.warning("    [WARN] Schema validation failure (Attempt %d): %s", attempt, err_trace)
            error_feedback = f"\n\nPREVIOUS VALIDATION ERROR: {err_trace}\nEnsure schema_fields is a flat dictionary, not nested."
        except APITimeoutError as e:
            log.warning("    [WARN] Schema discovery timeout (Attempt %d): %s", attempt, e)
            error_feedback = f"\n\nPREVIOUS ERROR: API timeout. The model took too long to respond."
        except Exception as e:
            err_trace = str(e).replace('\n', ' ')[:180]
            log.error("    [FAIL] Unexpected error in schema discovery (Attempt %d): %s", attempt, err_trace)
            log.error(traceback.format_exc())
            error_feedback = f"\n\nPREVIOUS ERROR: {err_trace}"

    log.error("  [FAIL] Fatal: All schema discovery attempts failed for cluster %d. Using fallback.", cluster_id)
    return ClusterSchema(
        granularity="coarse",
        rationale="Automatic fallback after all attempts failed.",
        schema_fields={"unstructured_data_payload": "string"},
        source="fallback"
    ), None


# ==============================================================================
# SECTION 6: JIT_OPTIMIZATION_ENGINE (Dynamic Compute Router)
# ==============================================================================

class AITaskJITCompiler:
    """
    Wraps expensive LLM/AI tasks. Records feature representations (Embeddings) against truth values.
    After 'warmup_jobs', it compiles the task into a rapid, deterministic XGBoost model.
    Periodically samples the truth to detect drift and recalibrates if error tolerance is breached.
    """
    def __init__(self, task_name: str, task_type: str, warmup_jobs: int = 10, error_tolerance: float = 10.0):
        self.task_name = task_name
        self.task_type = task_type
        self.warmup_jobs = warmup_jobs
        self.error_tolerance = error_tolerance
        self.history_X = []
        self.history_y = []
        self.model = None
        self.label_mapping = {}
        self.reverse_mapping = {}
        self.is_active = False
        self.calls = 0
        self.failures = 0

    def attempt_compile(self):
        try:
            X = np.vstack(self.history_X)
            if self.task_type == "regressor":
                self.model = xgb.XGBRegressor(n_estimators=50, max_depth=4, random_state=42)
                y = np.array(self.history_y)
                self.model.fit(X, y)
                self.is_active = True
                log.info("[JIT] ACTIVATED: [%s] -> XGBoost Regressor (%d samples).", self.task_name, len(self.history_y))
            else:
                unique_labels = list(set(self.history_y))
                if len(unique_labels) < 2:
                    log.warning("  [WARN] JIT [%s]: only 1 class, deferring compilation.", self.task_name)
                    return

                self.model = xgb.XGBClassifier(n_estimators=50, max_depth=4, random_state=42)
                self.label_mapping = {l: i for i, l in enumerate(unique_labels)}
                self.reverse_mapping = {i: l for i, l in enumerate(unique_labels)}
                y = np.array([self.label_mapping[l] for l in self.history_y])
                self.model.fit(X, y)
                self.is_active = True
                log.info("[JIT] ACTIVATED: [%s] -> XGBoost Classifier (%d samples).", self.task_name, len(self.history_y))
        except Exception as e:
            log.error("  [FAIL] JIT compilation failed for [%s]: %s", self.task_name, e)
            log.error(traceback.format_exc())

    def execute(self, X_input: np.ndarray, llm_fallback_fn: Callable) -> Tuple[Any, str]:
        self.calls += 1

        if not self.is_active:
            try:
                truth_value = llm_fallback_fn()
                self.history_X.append(X_input)
                self.history_y.append(truth_value)
                if len(self.history_X) >= self.warmup_jobs:
                    self.attempt_compile()
                return truth_value, "Native AI Execution (Warmup)"
            except Exception as e:
                self.failures += 1
                log.error("  [FAIL] JIT warmup execution failed [%s]: %s", self.task_name, e)
                raise

        if np.random.rand() < 0.10:
            try:
                truth_value = llm_fallback_fn()
                pred_value = self._predict_internal(X_input)

                drift_detected = False
                if self.task_type == "regressor":
                    error = abs(truth_value - pred_value)
                    if error > self.error_tolerance: drift_detected = True
                else:
                    if truth_value != pred_value: drift_detected = True

                if drift_detected:
                    log.warning("[JIT] DRIFT DETECTED: [%s] recalibrating...", self.task_name)
                    self.is_active = False
                    self.history_X.append(X_input)
                    self.history_y.append(truth_value)
                    return truth_value, "Native AI Execution (JIT Recalibrating)"
                else:
                    self.history_X.append(X_input)
                    self.history_y.append(truth_value)
                    return pred_value, "JIT Compiled Execution (Validated)"
            except Exception as e:
                self.failures += 1
                log.error("  [FAIL] JIT drift check failed [%s]: %s", self.task_name, e)
                return self._predict_internal(X_input), "JIT Compiled Execution (Fallback)"

        try:
            return self._predict_internal(X_input), "JIT Compiled Execution"
        except Exception as e:
            self.failures += 1
            log.error("  [FAIL] JIT prediction failed [%s]: %s", self.task_name, e)
            truth_value = llm_fallback_fn()
            return truth_value, "Native AI Execution (JIT Failure Fallback)"

    def _predict_internal(self, X_input: np.ndarray) -> Any:
        pred = self.model.predict(X_input.reshape(1, -1))[0]
        if self.task_type == "regressor":
            return float(pred)
        else:
            return self.reverse_mapping.get(int(pred), "Unknown Category")


