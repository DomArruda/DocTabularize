class PipelineVerifier:
    def __init__(self, cross_encoder_model: str, embedder: SentenceTransformer, cfg: HierarchicalConfig):
        log.info("[VERIFIER] Bootstrapping Verification Engine...")
        try:
            self.cross_encoder = CrossEncoder(cross_encoder_model)
            self.embedder = embedder
            self.db = duckdb.connect(database=':memory:')
            self.cfg = cfg
            log.info("  [OK] Cross-Encoder loaded.")
        except Exception as e:
            log.error("  [FAIL] Failed to initialize verification engine: %s", e)
            raise

        self.fidelity_jit = AITaskJITCompiler(
            task_name="Cross-Encoder Semantic Fidelity",
            task_type="regressor",
            warmup_jobs=cfg.job.jit_warmup_jobs,
            error_tolerance=cfg.job.jit_error_tolerance
        )
        self.fact_verification_failures = 0
        self.fact_verification_successes = 0

    def evaluate_extraction_fidelity(
        self,
        result: PageExtractionResult,
        meta: MetaStateJSON,
        schema: ClusterSchema,
        page_text: str,
        schema_level: Optional[SchemaLevelConfig] = None
    ) -> Tuple[float, str]:
        try:
            expected_keys = set(schema.schema_fields.keys())
            num_tables = len(result.tables)
            num_rows = sum(len(t.rows) for t in result.tables)
            feedback_buffer: List[str] = []

            if num_rows == 0:
                return (100.0, "Valid explicit empty layout verified.") if num_tables == 0 else (0.0, "Structural tables present with missing rows.")

            # --- Schema-level validation (if config provided) ---
            if schema_level:
                validation_errors = self._validate_against_schema_config(result, schema_level)
                if validation_errors:
                    feedback_buffer.append(f"Schema Validation: {len(validation_errors)} errors")

            def _expensive_cross_encoder_call():
                semantic_scores = []
                for table in result.tables:
                    for row in table.rows:
                        sentence = self._translate_row_to_sentence(row)
                        if sentence:
                            try:
                                logit = self.cross_encoder.predict([(page_text, sentence)])[0]
                                prob = 1 / (1 + math.exp(-logit))
                                semantic_scores.append(prob)
                            except Exception as e:
                                log.warning("      [WARN] Cross-encoder scoring failed for a row: %s", e)
                return float(np.mean(semantic_scores)) * 50.0 if semantic_scores else 0.0

            raw_json_str = result.model_dump_json()
            X_input = self.embedder.encode(raw_json_str)

            fidelity_allocation, jit_status = self.fidelity_jit.execute(X_input, llm_fallback_fn=_expensive_cross_encoder_call)

            if fidelity_allocation < 35.0:
                feedback_buffer.append("Fidelity Degradation Watch: Low textual grounding.")
            feedback_buffer.append(f"[{jit_status}]")

            structural_densities = []
            for table in result.tables:
                for r in table.rows:
                    populated_valid_keys = sum(1 for k in expected_keys if k in r and r[k] not in (None, "", "null"))
                    structural_densities.append(populated_valid_keys / max(1, len(expected_keys)))
            schema_allocation = (np.mean(structural_densities) * 30.0) if structural_densities else 0.0

            # --- DuckDB SQL Compliance (fixed: use pandas DataFrames) ---
            sql_successes = 0
            for table in result.tables:
                try:
                    if table.rows:
                        df = pd.DataFrame(table.rows)
                        self.db.register("test_rows_view", df)
                        self.db.sql("SELECT * FROM test_rows_view").fetchall()
                        sql_successes += 1
                except Exception as e:
                    feedback_buffer.append(f"SQL Compliance Failure: {str(e).splitlines()[0][:100]}")

            duckdb_allocation = (sql_successes / num_tables) * 20.0 if num_tables > 0 else 0.0

            master_score = fidelity_allocation + schema_allocation + duckdb_allocation

            retry_penalty = (meta.current_retry - 1) * 5
            if retry_penalty > 0:
                master_score -= retry_penalty
                feedback_buffer.append(f"Retry Penalty (-{retry_penalty})")

            return max(0.0, min(100.0, master_score)), " | ".join(feedback_buffer)
        except Exception as e:
            log.error("  [FAIL] Fidelity evaluation crashed: %s", e)
            log.error(traceback.format_exc())
            return 0.0, f"Evaluation error: {str(e)[:100]}"

    def _validate_against_schema_config(self, result: PageExtractionResult, s_cfg: SchemaLevelConfig) -> List[str]:
        """Validate extracted rows against schema-level constraints."""
        errors = []
        strict = s_cfg.validation.get("strict_types", False)
        allow_extra = s_cfg.validation.get("allow_extra_fields", True)
        expected_keys = set(s_cfg.fields.keys())

        for table in result.tables:
            for row in table.rows:
                row_keys = set(row.keys())
                if not allow_extra:
                    extra = row_keys - expected_keys
                    if extra:
                        errors.append(f"Extra fields disallowed: {extra}")

                for field_name, f_cfg in s_cfg.fields.items():
                    if f_cfg.required and field_name not in row:
                        errors.append(f"Missing required field: {field_name}")
                        continue
                    if field_name not in row:
                        continue
                    val = row[field_name]
                    if val in (None, "", "null"):
                        if f_cfg.required:
                            errors.append(f"Required field '{field_name}' is empty")
                        continue

                    # Type checks
                    if f_cfg.type == "integer":
                        try:
                            int(val)
                        except (ValueError, TypeError):
                            errors.append(f"'{field_name}' expected integer, got {type(val).__name__}")
                    elif f_cfg.type == "number":
                        try:
                            float(val)
                        except (ValueError, TypeError):
                            errors.append(f"'{field_name}' expected number, got {type(val).__name__}")
                    elif f_cfg.type == "string":
                        if not isinstance(val, str):
                            if strict:
                                errors.append(f"'{field_name}' expected string, got {type(val).__name__}")
                            else:
                                row[field_name] = str(val)

                    # Range checks
                    if f_cfg.type in ("integer", "number") and f_cfg.min is not None:
                        try:
                            if float(val) < f_cfg.min:
                                errors.append(f"'{field_name}' value {val} below minimum {f_cfg.min}")
                        except (ValueError, TypeError):
                            pass
                    if f_cfg.type in ("integer", "number") and f_cfg.max is not None:
                        try:
                            if float(val) > f_cfg.max:
                                errors.append(f"'{field_name}' value {val} above maximum {f_cfg.max}")
                        except (ValueError, TypeError):
                            pass

                    # Enum checks
                    if f_cfg.enum and str(val) not in f_cfg.enum:
                        errors.append(f"'{field_name}' value '{val}' not in enum {f_cfg.enum}")

                    # Regex checks
                    if f_cfg.validation and f_cfg.validation.startswith("regex:"):
                        pattern = f_cfg.validation.split(":", 1)[1]
                        if not re.match(pattern, str(val)):
                            errors.append(f"'{field_name}' value '{val}' does not match regex {pattern}")

                    # Max length
                    if f_cfg.max_length and len(str(val)) > f_cfg.max_length:
                        errors.append(f"'{field_name}' length {len(str(val))} exceeds max {f_cfg.max_length}")

        return errors

    def execute_cross_cluster_interrogation(self, clusters_data: Dict[str, Any]) -> Dict[str, Any]:
        log.info("[CROSS] Initiating cross-cluster data interrogation...")
        interrogation_results = {"relational_integrity_passed": True, "anomalies": []}
        try:
            all_tables: Dict[str, List[Dict[str, Any]]] = {}
            for cid, c_info in clusters_data.items():
                flat_rows = []
                for record in c_info.get("extraction_records", []):
                    for table in record.get("data", {}).get("tables", []):
                        flat_rows.extend(table.get("rows", []))
                all_tables[f"cluster_{cid}_rows"] = flat_rows

            available_views = []
            for t_name, rows in all_tables.items():
                if rows:
                    df = pd.DataFrame(rows)
                    self.db.register(t_name, df)
                    available_views.append(t_name)

            if len(available_views) >= 2:
                interrogation_results["reconciled_views"] = available_views
                log.info("  [OK] Cross-referenced %d relational views.", len(available_views))
        except Exception as e:
            log.error("  [FAIL] Cross-cluster interrogation failed: %s", e)
            log.error(traceback.format_exc())
            interrogation_results["relational_integrity_passed"] = False
            interrogation_results["anomalies"].append(f"Inter-cluster error: {str(e)}")
        return interrogation_results

    def _translate_row_to_sentence(self, row: Dict[str, Any]) -> str:
        tokens = [f"The {k} is {v}." for k, v in row.items() if v and str(v).strip().lower() not in ("null", "none", "")]
        return " ".join(tokens)

    @retry_on_failure(max_retries=3, delay=1.0)
    def _generate_question_from_row(self, row: Dict[str, Any], client: OpenAI, model_name: str) -> str:
        facts = json.dumps(row, indent=2)
        prompt = f"""You are a fact-checker. Given the following data row (in JSON), generate a single, concise question that this row answers. Only output the question, nothing else.

Data row:
{facts}

Question:"""
        response = client.chat.completions.create(
            model=model_name,
            messages=[{"role": "user", "content": prompt}],
            temperature=0.0,
            timeout=15
        )
        question = response.choices[0].message.content.strip()
        if not question:
            question = f"What is the value for this data? {json.dumps(row)}"
        return question

    def verify_row_against_cluster(
        self,
        row: Dict[str, Any],
        cluster_chunks: List[Chunk],
        client: OpenAI,
        model_name: str,
        faiss_index: Optional[faiss.IndexFlatL2] = None,
        chunk_map: Optional[List[Chunk]] = None
    ) -> Tuple[bool, float, str]:
        """Fact-check a row against cluster evidence.

        Uses a cached FAISS index if provided to avoid rebuilding per row.
        """
        try:
            question = self._generate_question_from_row(row, client, model_name)
            if not question:
                self.fact_verification_failures += 1
                return False, 0.0, ""

            q_emb = self.embedder.encode([question])[0]

            if faiss_index is not None and chunk_map is not None:
                _, idx = faiss_index.search(q_emb.reshape(1, -1), 1)
                best_chunk = chunk_map[idx[0][0]]
            else:
                # Fallback: rebuild index (inefficient)
                chunk_embs = np.vstack([c.embedding for c in cluster_chunks if c.embedding is not None])
                if len(chunk_embs) == 0:
                    self.fact_verification_failures += 1
                    return False, 0.0, "No embeddings available for cluster."
                index = faiss.IndexFlatL2(chunk_embs.shape[1])
                index.add(chunk_embs)
                _, idx = index.search(q_emb.reshape(1, -1), 1)
                best_chunk = cluster_chunks[idx[0][0]]

            evidence_text = best_chunk.text[:600]
            fact_sentence = self._translate_row_to_sentence(row)
            logit = self.cross_encoder.predict([(evidence_text, fact_sentence)])[0]
            confidence = 1 / (1 + math.exp(-logit))
            verified = confidence >= 0.5
            if verified:
                self.fact_verification_successes += 1
            else:
                self.fact_verification_failures += 1
            return verified, float(confidence), evidence_text
        except Exception as e:
            self.fact_verification_failures += 1
            log.warning("  [WARN] Fact verification error on row: %s", e)
            return False, 0.0, f"Verification error: {str(e)[:100]}"


