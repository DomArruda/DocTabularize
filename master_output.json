class Chunk:
    def __init__(self, chunk_id: int, page_num: int, text: str, source: str):
        self.chunk_id = chunk_id
        self.page_num = page_num
        self.text = text
        self.source = source
        self.embedding: Optional[np.ndarray] = None
        self.umap_coords: Optional[np.ndarray] = None
        self.cluster_id: Optional[int] = None


class ClusterSchema(BaseModel):
    granularity: str = Field(description="coarse | medium | fine")
    rationale: str = Field(description="Reasoning for structural fields selection")
    schema_fields: Dict[str, str] = Field(description="Flat mapping of field_name -> data type/desc. MUST NOT NEST LISTS.")
    parent_schema_id: Optional[str] = Field(default=None, description="ID of parent schema if this is a mutation")
    source: str = Field(default="discovered", description="discovered | config | evolved")


