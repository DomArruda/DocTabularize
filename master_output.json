class FieldConfig(BaseModel):
    """Schema-level field definition with validation constraints."""
    type: str = "string"
    required: bool = True
    description: Optional[str] = None
    validation: Optional[str] = None   # regex:..., email, range, etc.
    format: Optional[str] = None       # date/datetime format
    enum: Optional[List[str]] = None
    min: Optional[float] = None
    max: Optional[float] = None
    max_length: Optional[int] = None


class SchemaLevelConfig(BaseModel):
    """Table-level configuration bound to a specific cluster."""
    name: str
    cluster_id: int
    parent_schema_id: Optional[str] = None
    enabled: bool = True
    fields: Dict[str, FieldConfig] = Field(default_factory=dict)
    validation: Dict[str, Any] = Field(default_factory=dict)
    extraction: Dict[str, Any] = Field(default_factory=dict)

    @property
    def table_name(self) -> str:
        return self.extraction.get("table_name", self.name)

    @property
    def prompt_injection(self) -> Optional[str]:
        return self.extraction.get("prompt_injection")

    @property
    def max_rows(self) -> Optional[int]:
        return self.extraction.get("max_rows")


class ClusterLevelConfig(BaseModel):
    """Per-cluster overrides. Omitted fields inherit from JobLevelConfig."""
    id: int
    name: Optional[str] = None
    enabled: bool = True
    granularity: str = "medium"
    hdbscan_min_cluster: Optional[int] = None
    hdbscan_min_samples: Optional[int] = None
    samples_per_cluster: Optional[int] = None
    target_score: Optional[float] = None
    max_page_retries: Optional[int] = None
    extract_dpi: Optional[int] = None
    enable_fact_verification: Optional[bool] = None
    custom_prompt_injection: Optional[str] = None
    schema_overrides: List[str] = Field(default_factory=list)


class JobLevelConfig(BaseModel):
    """Per-execution behavioral policy."""
    target_score: float = 85.0
    max_page_retries: int = 3
    max_cluster_retries: int = 2
    enable_fact_verification: bool = False
    enable_schema_evolution: bool = True
    schema_evolution_top_k: int = 3
    jit_warmup_jobs: int = 10
    jit_error_tolerance: float = 15.0
    extraction: Dict[str, Any] = Field(default_factory=dict)
    clustering: Dict[str, Any] = Field(default_factory=dict)
    jit: Dict[str, Any] = Field(default_factory=dict)


class PipelineLevelConfig(BaseModel):
    """Global infrastructure and I/O configuration."""
    name: str = "document_refinery"
    version: str = "2.0.0"
    doc_path: str = ""
    output_path: str = "master_output.json"
    error_log_path: Optional[str] = None
    cache_path: Optional[str] = None
    schema_db_path: Optional[str] = None
    ollama_json_mode: str = "json"   # "json_schema" | "json" | "legacy"
    models: Dict[str, str] = Field(default_factory=dict)
    logging: Dict[str, Any] = Field(default_factory=dict)


class ResolvedClusterConfig:
    """Runtime-resolved configuration for a single cluster.

    Merges JobLevelConfig defaults with ClusterLevelConfig overrides.
    """
    def __init__(self, cluster: ClusterLevelConfig, job: JobLevelConfig):
        self.cluster_id = cluster.id
        self.name = cluster.name or f"cluster_{cluster.id}"
        self.enabled = cluster.enabled
        self.granularity = cluster.granularity

        # Cluster overrides Job where explicitly provided
        self.hdbscan_min_cluster = (
            cluster.hdbscan_min_cluster
            if cluster.hdbscan_min_cluster is not None
            else job.clustering.get("hdbscan_min_cluster", 3)
        )
        self.hdbscan_min_samples = (
            cluster.hdbscan_min_samples
            if cluster.hdbscan_min_samples is not None
            else job.clustering.get("hdbscan_min_samples", 2)
        )
        self.samples_per_cluster = (
            cluster.samples_per_cluster
            if cluster.samples_per_cluster is not None
            else job.clustering.get("samples_per_cluster", 3)
        )
        self.target_score = (
            cluster.target_score if cluster.target_score is not None else job.target_score
        )
        self.max_page_retries = (
            cluster.max_page_retries if cluster.max_page_retries is not None else job.max_page_retries
        )
        self.extract_dpi = (
            cluster.extract_dpi if cluster.extract_dpi is not None else job.extraction.get("extract_dpi", 150)
        )
        self.enable_fact_verification = (
            cluster.enable_fact_verification
            if cluster.enable_fact_verification is not None
            else job.enable_fact_verification
        )
        self.custom_prompt_injection = cluster.custom_prompt_injection or ""
        self.schema_overrides = cluster.schema_overrides

        # Job-level only (no cluster override)
        self.max_cluster_retries = job.max_cluster_retries
        self.enable_schema_evolution = job.enable_schema_evolution
        self.schema_evolution_top_k = job.schema_evolution_top_k
        self.jit_warmup_jobs = job.jit.get("sequential_jobs_before_jit", job.jit_warmup_jobs)
        self.jit_error_tolerance = job.jit.get("error_tolerance", job.jit_error_tolerance)
        self.max_rows_per_cluster = job.extraction.get("max_rows_per_cluster", 100)
        self.max_tables_per_cluster = job.extraction.get("max_tables_per_cluster", 5)
        self.target_features = job.extraction.get("target_features", 8)
        self.umap_components = job.clustering.get("umap_components", 5)
        self.umap_neighbors = job.clustering.get("umap_neighbors", 15)
        self.umap_min_dist = job.clustering.get("umap_min_dist", 0.1)


class HierarchicalConfig:
    """Parses and resolves the four-tier TOML configuration hierarchy."""

    def __init__(self, toml_path: str = "pipeline_config.toml"):
        self.toml_path = Path(toml_path)
        if not self.toml_path.exists():
            log.warning("Configuration file '%s' not found. Generating production defaults.", toml_path)
            self._generate_default_toml(self.toml_path)

        with open(self.toml_path, "rb") as f:
            raw = tomllib.load(f)

        self.pipeline = PipelineLevelConfig(**raw.get("pipeline", {}))
        self.job = JobLevelConfig(**raw.get("job", {}))

        # Parse clusters (array-of-tables)
        self.clusters: Dict[int, ClusterLevelConfig] = {}
        for c_raw in raw.get("cluster", []):
            c = ClusterLevelConfig(**c_raw)
            self.clusters[c.id] = c

        # Parse schemas (array-of-tables)
        self.schemas: Dict[str, SchemaLevelConfig] = {}
        for s_raw in raw.get("schema", []):
            s = SchemaLevelConfig(**s_raw)
            self.schemas[s.name] = s

        self._resolve_paths()
        self._setup_logging()

        log.info("[CONFIG] Hierarchical config loaded: %d clusters, %d schemas",
                 len(self.clusters), len(self.schemas))

    def _resolve_paths(self):
        """Resolve relative paths against the TOML file location."""
        base = self.toml_path.parent
        for attr in ["output_path", "error_log_path", "cache_path", "schema_db_path", "doc_path"]:
            val = getattr(self.pipeline, attr)
            if val and not Path(val).is_absolute():
                setattr(self.pipeline, attr, str(base / val))

    def _setup_logging(self):
        """Configure logging from pipeline.logging settings."""
        log_cfg = self.pipeline.logging
        level = getattr(logging, log_cfg.get("level", "INFO").upper(), logging.INFO)
        fmt = log_cfg.get("format", "%(asctime)s [%(levelname)s] %(message)s")
        handlers = []
        if "console" in log_cfg.get("handlers", ["console"]):
            handlers.append(logging.StreamHandler(sys.stdout))
        if "file" in log_cfg.get("handlers", []):
            err_path = Path(self.pipeline.error_log_path or tempfile.gettempdir())
            err_path.parent.mkdir(parents=True, exist_ok=True)
            handlers.append(logging.FileHandler(err_path, mode="a", encoding="utf-8"))

        logging.basicConfig(level=level, format=fmt, handlers=handlers)
        log.info("[CONFIG] Logging initialized at level %s", logging.getLevelName(level))

    def get_cluster_config(self, cluster_id: int) -> ResolvedClusterConfig:
        """Resolve runtime configuration for a specific cluster."""
        cluster = self.clusters.get(cluster_id, ClusterLevelConfig(id=cluster_id))
        return ResolvedClusterConfig(cluster, self.job)

    def get_schemas_for_cluster(self, cluster_id: int) -> List[SchemaLevelConfig]:
        """Return enabled schemas bound to a specific cluster."""
        return [s for s in self.schemas.values() if s.cluster_id == cluster_id and s.enabled]

    def get_schema(self, name: str) -> Optional[SchemaLevelConfig]:
        return self.schemas.get(name)

    def _generate_default_toml(self, path: Path):
        default = """[pipeline]
doc_path = ""
output_path = "master_output.json"
ollama_json_mode = "json"

[pipeline.models]
embedding_model = "all-MiniLM-L6-v2"
cross_encoder_model = "cross-encoder/ms-marco-MiniLM-L-6-v2"
ollama_url = "http://localhost:11434/v1"
schema_model = "qwen2.5-vl:7b"
vision_model = "qwen2.5-vl:7b"

[pipeline.logging]
level = "INFO"
format = "%(asctime)s [%(levelname)s] %(message)s"
handlers = ["console", "file"]

[job]
target_score = 85.0
max_page_retries = 3
max_cluster_retries = 2
enable_fact_verification = false
enable_schema_evolution = true
schema_evolution_top_k = 3

[job.extraction]
target_features = 8
max_rows_per_cluster = 100
max_tables_per_cluster = 5
extract_dpi = 150

[job.clustering]
umap_components = 5
umap_neighbors = 15
umap_min_dist = 0.1
hdbscan_min_cluster = 3
hdbscan_min_samples = 2
samples_per_cluster = 3

[job.jit]
sequential_jobs_before_jit = 10
error_tolerance = 15.0
"""
        path.write_text(default, encoding="utf-8")


