def execute_pipeline_refinery():
    """Main pipeline orchestrator with hierarchical configuration and comprehensive error handling."""
    overall_start = time.time()
    pipeline_errors = []

    try:
        log.info("=" * 60)
        log.info("[START] INITIALIZING DOCUMENT REFINERY PIPELINE v2.0")
        log.info("=" * 60)

        # Load hierarchical configuration
        try:
            cfg = HierarchicalConfig("pipeline_config.toml")
            log.info("[CONFIG] Pipeline '%s' v%s", cfg.pipeline.name, cfg.pipeline.version)
            log.info("[CONFIG] Document: %s", cfg.pipeline.doc_path)
        except Exception as e:
            log.critical("[FAIL] Failed to load configuration: %s", e)
            raise

        # Initialize state cache
        cache_path = cfg.pipeline.cache_path or str(Path(tempfile.gettempdir()) / "llm_refinery_cache.json")
        init_execution_state_cache(cache_path)
        log.info("[STATE] State cache initialized at %s", cache_path)

        # Initialize API client
        try:
            client = OpenAI(base_url=cfg.pipeline.models.get("ollama_url", "http://localhost:11434/v1"), api_key="ollama")
            log.info("[CLIENT] Ollama client initialized: %s", cfg.pipeline.models.get("ollama_url"))
        except Exception as e:
            log.critical("[FAIL] Failed to initialize Ollama client: %s", e)
            raise

        # Load models
        log.info("[MODELS] Loading models...")
        try:
            embedder = SentenceTransformer(cfg.pipeline.models.get("embedding_model", "all-MiniLM-L6-v2"))
            log.info("  [OK] Embedding model loaded: %s", cfg.pipeline.models.get("embedding_model"))
        except Exception as e:
            log.critical("[FAIL] Failed to load embedding model: %s", e)
            raise

        try:
            verifier = PipelineVerifier(cfg.pipeline.models.get("cross_encoder_model"), embedder, cfg)
            log.info("  [OK] Verification engine initialized.")
        except Exception as e:
            log.critical("[FAIL] Failed to initialize verifier: %s", e)
            raise

        # Initialize schema registry
        registry = None
        schema_db_path = Path(cfg.pipeline.schema_db_path or tempfile.gettempdir()) / "schema_registry.duckdb"
        if cfg.job.enable_schema_evolution:
            try:
                registry = SchemaRegistry(schema_db_path)
                log.info("  [OK] Schema registry initialized.")
            except Exception as e:
                log.warning("  [WARN] Schema registry failed, continuing without evolution: %s", e)
                cfg.job.enable_schema_evolution = False

        # ------------------------------------------------------------------
        # STAGE 1: INGESTION
        # ------------------------------------------------------------------
        log.info("\n" + "=" * 60)
        log.info("[STAGE 1] DOCUMENT INGESTION")
        log.info("=" * 60)

        try:
            chunks = ingest_document(cfg.pipeline.doc_path)
            if not chunks:
                log.critical("[FAIL] No chunks extracted from document. Exiting.")
                return
        except FileNotFoundError:
            log.critical("[FAIL] Document not found: %s", cfg.pipeline.doc_path)
            pipeline_errors.append(f"File not found: {cfg.pipeline.doc_path}")
            return
        except Exception as e:
            log.critical("[FAIL] Ingestion failed: %s", e)
            log.critical(traceback.format_exc())
            pipeline_errors.append(f"Ingestion error: {str(e)[:100]}")
            return

        # ------------------------------------------------------------------
        # STAGE 2: EMBEDDING GENERATION
        # ------------------------------------------------------------------
        log.info("\n" + "=" * 60)
        log.info("[STAGE 2] EMBEDDING GENERATION")
        log.info("=" * 60)

        try:
            chunks = execute_embedding_generation(chunks, cfg.pipeline.models.get("embedding_model"))
        except Exception as e:
            log.critical("[FAIL] Embedding generation failed: %s", e)
            pipeline_errors.append(f"Embedding error: {str(e)[:100]}")
            return

        # ------------------------------------------------------------------
        # STAGE 3: MANIFOLD REDUCTION & CLUSTERING
        # ------------------------------------------------------------------
        log.info("\n" + "=" * 60)
        log.info("[STAGE 3] DIMENSIONALITY REDUCTION & CLUSTERING")
        log.info("=" * 60)

        # Use a temporary resolved config for clustering (uses job defaults)
        temp_cluster_cfg = ResolvedClusterConfig(ClusterLevelConfig(id=-1), cfg.job)

        if len(chunks) < temp_cluster_cfg.umap_neighbors:
            original = temp_cluster_cfg.umap_neighbors
            temp_cluster_cfg.umap_neighbors = max(2, len(chunks) - 1)
            log.warning("  [WARN] Adjusted umap_neighbors from %d to %d (not enough chunks)", original, temp_cluster_cfg.umap_neighbors)

        try:
            chunks = run_manifold_reduction(chunks, temp_cluster_cfg)
        except Exception as e:
            log.critical("[FAIL] UMAP reduction failed: %s", e)
            pipeline_errors.append(f"UMAP error: {str(e)[:100]}")
            return

        try:
            cluster_densities = generate_spatial_density_clusters(chunks, temp_cluster_cfg)
            valid_clusters = [cid for cid in cluster_densities if cid != -1]
            if not valid_clusters:
                log.error("[FAIL] No valid clusters found. All points classified as noise.")
                log.error("   Try adjusting hdbscan_min_cluster or hdbscan_min_samples in config.")
                pipeline_errors.append("Clustering failed: all points are noise")
                return
        except Exception as e:
            log.critical("[FAIL] Clustering failed: %s", e)
            pipeline_errors.append(f"Clustering error: {str(e)[:100]}")
            return

        try:
            sampled_cluster_map = isolate_medoid_samples(chunks, temp_cluster_cfg)
        except Exception as e:
            log.critical("[FAIL] Medoid sampling failed: %s", e)
            pipeline_errors.append(f"Sampling error: {str(e)[:100]}")
            return

        # ------------------------------------------------------------------
        # STAGE 4: SCHEMA DISCOVERY (per-cluster with hierarchy)
        # ------------------------------------------------------------------
        log.info("\n" + "=" * 60)
        log.info("[STAGE 4] SCHEMA DISCOVERY & RESOLUTION")
        log.info("=" * 60)

        cluster_schemas: Dict[int, ClusterSchema] = {}
        cluster_schema_configs: Dict[int, Optional[SchemaLevelConfig]] = {}
        failed_clusters = []

        for cid, samples in sampled_cluster_map.items():
            cluster_cfg = cfg.get_cluster_config(cid)

            if not cluster_cfg.enabled:
                log.info("  [CLUSTER %d] Disabled by configuration, skipping.", cid)
                continue

            try:
                log.info("  Resolving schema for cluster %d (%s)...", cid, cluster_cfg.name)
                schema, s_level = execute_protected_schema_discovery(
                    cid, samples, cluster_cfg, client, cfg, registry
                )
                cluster_schemas[cid] = schema
                cluster_schema_configs[cid] = s_level
                log.info("  [OK] Cluster %d schema: %s (source=%s), %d fields",
                         cid, schema.granularity, schema.source, len(schema.schema_fields))
            except Exception as e:
                log.error("  [FAIL] Schema discovery crashed for cluster %d: %s", cid, e)
                log.error(traceback.format_exc())
                failed_clusters.append(cid)
                cluster_schemas[cid] = ClusterSchema(
                    granularity="coarse",
                    rationale="Schema discovery crashed; using fallback.",
                    schema_fields={"raw_text": "string"},
                    source="fallback"
                )
                cluster_schema_configs[cid] = None

        if failed_clusters:
            log.warning("  [WARN] %d clusters used fallback schemas: %s", len(failed_clusters), failed_clusters)

        # ------------------------------------------------------------------
        # STAGE 5: VISION EXTRACTION (per-cluster with resolved config)
        # ------------------------------------------------------------------
        log.info("\n" + "=" * 60)
        log.info("[STAGE 5] VISION-BASED EXTRACTION")
        log.info("=" * 60)

        master_payload: Dict[str, Any] = {"clusters": {}}
        overall_scores = []
        clusters_completed = 0
        clusters_failed = 0

        # Open PDF once for entire extraction phase
        try:
            if Path(cfg.pipeline.doc_path).suffix.lower() != ".pdf":
                log.error("[FAIL] Vision extraction requires PDF input.")
                pipeline_errors.append("Non-PDF input for vision extraction")
                return
            doc_handle = fitz.open(cfg.pipeline.doc_path)
        except Exception as e:
            log.error("[FAIL] Failed to open PDF for rendering: %s", e)
            pipeline_errors.append(f"PDF open error: {str(e)[:100]}")
            return

        try:
            for cid, schema in cluster_schemas.items():
                cluster_cfg = cfg.get_cluster_config(cid)
                if not cluster_cfg.enabled:
                    continue

                cluster_start = time.time()
                log.info("\n" + "-" * 60)
                log.info("[CLUSTER %d] Processing (%d/%d)", cid, clusters_completed + 1, len(cluster_schemas))
                log.info("-" * 60)

                try:
                    cid_chunks = [c for c in chunks if c.cluster_id == cid]
                    page_numbers = sorted(set(c.page_num for c in cid_chunks))
                    log.info("  Pages to process: %d (pages %d-%d)", len(page_numbers), min(page_numbers), max(page_numbers))

                    extraction_records_collector = []
                    cumulative_tables = 0
                    cumulative_rows = 0
                    cluster_scores = []
                    checkpoint_summaries = []
                    pages_processed = 0
                    pages_failed = 0

                    schema_json_str = json.dumps(schema.schema_fields, indent=2)
                    page_count_in_cluster = 0

                    # Pre-build FAISS index for fact verification if enabled
                    faiss_index = None
                    chunk_map = None
                    if cluster_cfg.enable_fact_verification:
                        valid_embs = [c for c in cid_chunks if c.embedding is not None]
                        if valid_embs:
                            chunk_embs = np.vstack([c.embedding for c in valid_embs]).astype("float32")
                            faiss_index = faiss.IndexFlatL2(chunk_embs.shape[1])
                            faiss_index.add(chunk_embs)
                            chunk_map = valid_embs

                    for page_num in page_numbers:
                        page_start = time.time()
                        page_count_in_cluster += 1

                        try:
                            log.info("\n  [PAGE %d] (%d/%d)", page_num, page_count_in_cluster, len(page_numbers))

                            img_b64 = _convert_pdf_page_to_b64_image(doc_handle, page_num, cluster_cfg.extract_dpi)

                            page_chunks = [c for c in cid_chunks if c.page_num == page_num]
                            page_context_text = page_chunks[0].text if page_chunks else ""

                            best_page_result: Optional[PageExtractionResult] = None
                            best_page_score = -1.0
                            previous_score = 0.0
                            previous_feedback = "Initial extraction attempt."

                            for attempt in range(1, cluster_cfg.max_page_retries + 1):
                                attempt_start = time.time()

                                try:
                                    cache_state = get_execution_state_cache(cache_path)
                                    failure_rate = (cache_state.total_parse_failures / cache_state.total_attempts) \
                                        if cache_state.total_attempts > 0 else 0.0

                                    meta_state = MetaStateJSON(
                                        cluster_id=cid, page_num=page_num,
                                        current_retry=attempt, max_retries=cluster_cfg.max_page_retries,
                                        cumulative_tables=cumulative_tables, cumulative_rows=cumulative_rows,
                                        global_parse_failure_rate=failure_rate,
                                        total_global_attempts=cache_state.total_attempts,
                                        historical_errors_from_previous_calls=cache_state.recent_errors,
                                        previous_score=previous_score, previous_feedback=previous_feedback
                                    )

                                    # Build prompt with schema-level and cluster-level injections
                                    prompt_injections = []
                                    if cluster_cfg.custom_prompt_injection:
                                        prompt_injections.append(cluster_cfg.custom_prompt_injection)
                                    s_cfg = cluster_schema_configs.get(cid)
                                    if s_cfg and s_cfg.prompt_injection:
                                        prompt_injections.append(s_cfg.prompt_injection)

                                    injection_text = "\n\n".join(prompt_injections)

                                    system_prompt = f"""You are a specialized vision-based data refinery engine. Extract tabular structural components from page images.
TARGET EXTRACTION SCHEMA:
{schema_json_str}

You MUST output a JSON object that exactly matches the PageExtractionResult schema, containing 'reasoning' and a 'tables' list.
Each table has 'table_name' and 'rows' (a list of flat dictionaries).
Do not output raw rows without the envelope.

EXECUTION TRACKING STATE:
{meta_state.model_dump_json(indent=2)}

ADDITIONAL CONTEXT:
{injection_text}

If previous score is low, adjust your extraction parsing strategy to capture values with stronger precision."""

                                    log.debug("    Attempt %d/%d...", attempt, cluster_cfg.max_page_retries)

                                    # Ollama-compatible JSON mode selection
                                    api_kwargs = {
                                        "model": cfg.pipeline.models.get("vision_model", "qwen2.5-vl:7b"),
                                        "messages": [
                                            {"role": "system", "content": system_prompt},
                                            {"role": "user", "content": [
                                                {"type": "image_url",
                                                 "image_url": {"url": f"data:image/png;base64,{img_b64}"}},
                                                {"type": "text",
                                                 "text": "Extract all structural rows matching the required schema."}
                                            ]}
                                        ],
                                        "temperature": 0.02 + (attempt * 0.04),
                                        "timeout": 60
                                    }

                                    if cfg.pipeline.ollama_json_mode == "json_schema":
                                        api_kwargs["extra_body"] = {
                                            "format": {
                                                "type": "json_schema",
                                                "json_schema": {
                                                    "name": "page_extraction_result",
                                                    "schema": PAGE_RESULT_SCHEMA
                                                }
                                            }
                                        }
                                    elif cfg.pipeline.ollama_json_mode == "json":
                                        api_kwargs["response_format"] = {"type": "json_object"}
                                    # else: legacy mode — no format enforcement

                                    response = client.chat.completions.create(**api_kwargs)

                                    raw_text = response.choices[0].message.content
                                    parsed_result = PageExtractionResult.model_validate_json(raw_text)
                                    mutate_execution_state_cache(cache_path, is_failure=False)

                                    score, feedback = verifier.evaluate_extraction_fidelity(
                                        parsed_result, meta_state, schema, page_context_text,
                                        schema_level=cluster_schema_configs.get(cid)
                                    )

                                    attempt_time = time.time() - attempt_start
                                    log.info("    [OK] Attempt %d: Score %.1f/100 (%.1fs) - %s",
                                             attempt, score, attempt_time, feedback[:80])

                                    if score > best_page_score:
                                        best_page_score = score
                                        best_page_result = parsed_result

                                    if score >= cluster_cfg.target_score:
                                        log.info("    [TARGET] Target score reached, stopping retries.")
                                        break

                                    previous_score = score
                                    previous_feedback = feedback

                                except ValidationError as e:
                                    err_msg = f"Pydantic validation: {str(e)[:120]}"
                                    log.warning("    [WARN] Validation error (Attempt %d): %s", attempt, err_msg)
                                    mutate_execution_state_cache(cache_path, is_failure=True, error_msg=err_msg)
                                    previous_score = 0.0
                                    previous_feedback = f"Validation Error: {err_msg}"

                                except (APITimeoutError, APIConnectionError) as e:
                                    err_msg = f"API error: {str(e)[:100]}"
                                    log.warning("    [WARN] API error (Attempt %d): %s", attempt, err_msg)
                                    mutate_execution_state_cache(cache_path, is_failure=True, error_msg=err_msg)
                                    time.sleep(2 * attempt)
                                    previous_feedback = f"API Error: {err_msg}"

                                except json.JSONDecodeError as e:
                                    err_msg = f"JSON parse error: {str(e)[:120]}"
                                    log.warning("    [WARN] JSON error (Attempt %d): %s", attempt, err_msg)
                                    log.debug("    Raw content: %s", raw_text[:300] if 'raw_text' in dir() else 'N/A')
                                    mutate_execution_state_cache(cache_path, is_failure=True, error_msg=err_msg)
                                    previous_score = 0.0
                                    previous_feedback = f"JSON Error: {err_msg}"

                                except Exception as e:
                                    err_msg = str(e).replace('\n', ' ')[:150]
                                    log.error("    [FAIL] Unexpected error (Attempt %d): %s", attempt, err_msg)
                                    log.error(traceback.format_exc())
                                    mutate_execution_state_cache(cache_path, is_failure=True, error_msg=err_msg)
                                    previous_score = 0.0
                                    previous_feedback = f"Error: {err_msg}"

                            if best_page_result:
                                cumulative_tables += len(best_page_result.tables)
                                for t in best_page_result.tables:
                                    cumulative_rows += len(t.rows)
                                extraction_records_collector.append({
                                    "page_num": page_num,
                                    "score_achieved": best_page_score,
                                    "data": best_page_result.model_dump()
                                })
                                cluster_scores.append(best_page_score)
                                pages_processed += 1
                                page_time = time.time() - page_start
                                log.info("  [OK] Page %d completed (best score: %.1f, %.1fs)", page_num, best_page_score, page_time)
                            else:
                                pages_failed += 1
                                log.error("  [FAIL] Page %d FAILED after %d attempts", page_num, cluster_cfg.max_page_retries)
                                pipeline_errors.append(f"Page {page_num} in cluster {cid} failed")

                            if page_count_in_cluster % 5 == 0 or page_count_in_cluster == len(page_numbers):
                                try:
                                    summary = generate_cluster_checkpoint_summary(
                                        cid, extraction_records_collector, client,
                                        cfg.pipeline.models.get("schema_model", "qwen2.5-vl:7b")
                                    )
                                    checkpoint_summaries.append({
                                        "page_checkpoint": page_count_in_cluster,
                                        "summary": summary
                                    })
                                    log.info("    [CHECKPOINT] Summary generated (%d pages)", page_count_in_cluster)
                                except Exception as e:
                                    log.warning("    [WARN] Checkpoint summary failed: %s", e)

                        except Exception as e:
                            log.error("  [FAIL] Fatal error processing page %d: %s", page_num, e)
                            log.error(traceback.format_exc())
                            pages_failed += 1
                            pipeline_errors.append(f"Page {page_num} processing crashed: {str(e)[:100]}")

                    # ------------------------------------------------------------------
                    # FACT VERIFICATION (optional, per-cluster)
                    # ------------------------------------------------------------------
                    verified_rows = 0
                    total_rows = 0
                    if cluster_cfg.enable_fact_verification and extraction_records_collector:
                        log.info("\n  [FACT] Running fact verification on cluster %d...", cid)
                        for record in extraction_records_collector:
                            for table in record["data"]["tables"]:
                                for row in table["rows"]:
                                    total_rows += 1
                                    try:
                                        verified, confidence, evidence = verifier.verify_row_against_cluster(
                                            row, cid_chunks, client,
                                            cfg.pipeline.models.get("schema_model", "qwen2.5-vl:7b"),
                                            faiss_index=faiss_index, chunk_map=chunk_map
                                        )
                                        row["fact_verified"] = verified
                                        row["fact_confidence"] = round(confidence, 4)
                                        row["source_evidence"] = evidence[:300]
                                        if verified:
                                            verified_rows += 1
                                    except Exception as e:
                                        log.debug("      Fact verification skipped for row: %s", e)
                                        row["fact_verified"] = False
                                        row["fact_confidence"] = 0.0
                                        row["source_evidence"] = f"Verification error: {str(e)[:100]}"

                        log.info("  [OK] Fact verification: %d/%d rows verified (%.1f%%)",
                                 verified_rows, total_rows, 100*verified_rows/max(1,total_rows))

                    # ------------------------------------------------------------------
                    # CLUSTER FINALIZATION
                    # ------------------------------------------------------------------
                    avg_cluster_score = round(float(np.mean(cluster_scores)), 2) if cluster_scores else 0.0
                    overall_scores.append(avg_cluster_score)
                    final_summary = checkpoint_summaries[-1]["summary"] if checkpoint_summaries else "No summary generated."

                    cluster_time = time.time() - cluster_start

                    master_payload["clusters"][str(cid)] = {
                        "status": "done",
                        "heuristic_score": avg_cluster_score,
                        "final_summary": final_summary,
                        "checkpoint_summaries": checkpoint_summaries,
                        "metadata": {
                            "total_clustered_pages": cluster_densities.get(cid, 0),
                            "pages_processed": pages_processed,
                            "pages_failed": pages_failed,
                            "processing_time_seconds": round(cluster_time, 1)
                        },
                        "schema_definition": schema.model_dump(),
                        "extraction_records": extraction_records_collector
                    }

                    if cfg.job.enable_schema_evolution and registry and extraction_records_collector:
                        try:
                            schema_id = registry.generate_schema_id(cid, schema.parent_schema_id)
                            registry.register_schema(
                                schema_id, cid, schema, avg_cluster_score,
                                cumulative_rows, cfg.pipeline.doc_path, schema.parent_schema_id
                            )
                        except Exception as e:
                            log.warning("  [WARN] Schema registration failed: %s", e)

                    clusters_completed += 1
                    log.info("\n  [OK] Cluster %d COMPLETED: Score=%.1f, Pages=%d/%d, Rows=%d, Time=%.1fs",
                             cid, avg_cluster_score, pages_processed, pages_processed+pages_failed,
                             cumulative_rows, cluster_time)

                except Exception as e:
                    log.error("\n  [FAIL] Cluster %d FATAL ERROR: %s", cid, e)
                    log.error(traceback.format_exc())
                    clusters_failed += 1
                    pipeline_errors.append(f"Cluster {cid} fatal error: {str(e)[:100]}")

                    master_payload["clusters"][str(cid)] = {
                        "status": "failed",
                        "error": str(e)[:200],
                        "heuristic_score": 0.0,
                        "extraction_records": []
                    }

        finally:
            # Ensure PDF is always closed
            doc_handle.close()
            log.info("[STAGE 5] PDF rendering handle closed.")

        # ------------------------------------------------------------------
        # STAGE 6: CROSS-CLUSTER INTERROGATION
        # ------------------------------------------------------------------
        log.info("\n" + "=" * 60)
        log.info("[STAGE 6] CROSS-CLUSTER INTERROGATION")
        log.info("=" * 60)

        try:
            global_reconciliation_report = verifier.execute_cross_cluster_interrogation(
                master_payload["clusters"]
            )
            master_payload["global_reconciliation_report"] = global_reconciliation_report
            if global_reconciliation_report.get("relational_integrity_passed"):
                log.info("  [OK] Cross-cluster integrity check passed.")
            else:
                log.warning("  [WARN] Cross-cluster anomalies: %s", global_reconciliation_report.get("anomalies", []))
        except Exception as e:
            log.error("  [FAIL] Cross-cluster interrogation failed: %s", e)
            log.error(traceback.format_exc())
            pipeline_errors.append(f"Cross-cluster error: {str(e)[:100]}")
            master_payload["global_reconciliation_report"] = {
                "relational_integrity_passed": False,
                "anomalies": [f"Interrogation failed: {str(e)[:100]}"]
            }

        # ------------------------------------------------------------------
        # FINALIZE
        # ------------------------------------------------------------------
        overall_time = time.time() - overall_start
        overall_pipeline_score = round(float(np.mean(overall_scores)), 2) if overall_scores else 0.0

        master_payload["pipeline_summary"] = {
            "overall_performance_score": overall_pipeline_score,
            "clusters_total": len(cluster_schemas),
            "clusters_completed": clusters_completed,
            "clusters_failed": clusters_failed,
            "target_score": cfg.job.target_score,
            "fact_verification_enabled": cfg.job.enable_fact_verification,
            "schema_evolution_enabled": cfg.job.enable_schema_evolution,
            "total_processing_time_seconds": round(overall_time, 1),
            "pipeline_errors": pipeline_errors if pipeline_errors else ["None"],
            "error_log_path": str(cfg.pipeline.error_log_path or Path(tempfile.gettempdir()) / "refinery_errors.log")
        }

        try:
            output_path = Path(cfg.pipeline.output_path)
            output_path.parent.mkdir(parents=True, exist_ok=True)
            output_path.write_text(
                json.dumps(master_payload, indent=2, ensure_ascii=False),
                encoding="utf-8"
            )
            log.info("\n" + "=" * 60)
            log.info("[DONE] PIPELINE COMPLETED SUCCESSFULLY")
            log.info("=" * 60)
            log.info("  Output: %s", cfg.pipeline.output_path)
            log.info("  Overall Score: %.1f/100", overall_pipeline_score)
            log.info("  Clusters: %d/%d completed", clusters_completed, len(cluster_schemas))
            log.info("  Errors: %d", len(pipeline_errors))
            log.info("  Total Time: %.1fs", overall_time)
            log.info("  Error Log: %s", cfg.pipeline.error_log_path)
            log.info("=" * 60)
        except Exception as e:
            log.critical("[FAIL] Failed to write output: %s", e)
            log.critical(traceback.format_exc())

        if pipeline_errors:
            log.warning("\n[WARN] PIPELINE ERROR SUMMARY (%d errors):", len(pipeline_errors))
            for i, err in enumerate(pipeline_errors[:10], 1):
                log.warning("  %d. %s", i, err)
            if len(pipeline_errors) > 10:
                log.warning("  ... and %d more errors", len(pipeline_errors) - 10)

    except Exception as e:
        log.critical("\n" + "=" * 60)
        log.critical("[CRASH] PIPELINE CRASHED WITH FATAL ERROR")
        log.critical("=" * 60)
        log.critical("Error: %s", e)
        log.critical(traceback.format_exc())
        log.critical("Full error log: %s", cfg.pipeline.error_log_path if 'cfg' in dir() else "unknown")
        raise

    finally:
        log.info("\n[DONE] Full error log saved to: %s",
                 cfg.pipeline.error_log_path if 'cfg' in dir() else Path(tempfile.gettempdir()) / "refinery_errors.log")


if __name__ == "__main__":
    try:
        execute_pipeline_refinery()
    except FileNotFoundError as fnf:
        log.critical("[FAIL] File not found: %s", fnf)
        log.critical("   Please check that your PDF exists at the path specified in pipeline_config.toml")
        sys.exit(1)
    except KeyboardInterrupt:
        log.warning("[WARN] Pipeline interrupted by user.")
        sys.exit(130)
    except Exception as e:
        log.critical("[FAIL] Unhandled exception: %s", e)
        log.critical(traceback.format_exc())
