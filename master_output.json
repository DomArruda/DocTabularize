def init_execution_state_cache(cache_path: str):
    try:
        Path(cache_path).parent.mkdir(parents=True, exist_ok=True)
        Path(cache_path).write_text(GlobalCache().model_dump_json())
        log.debug("Execution state cache initialized.")
    except Exception as e:
        log.warning("[WARN] Could not initialize cache: %s", e)


def mutate_execution_state_cache(cache_path: str, is_failure: bool, error_msg: Optional[str] = None):
    if not Path(cache_path).exists():
        init_execution_state_cache(cache_path)
    try:
        cache = GlobalCache.model_validate_json(Path(cache_path).read_text())
        cache.total_attempts += 1
        if is_failure:
            cache.total_parse_failures += 1
            if error_msg:
                cache.recent_errors.append(error_msg)
                if len(cache.recent_errors) > cache.max_error_memory:
                    cache.recent_errors.pop(0)
        Path(cache_path).write_text(cache.model_dump_json())
    except Exception as e:
        log.debug("Cache mutation skipped: %s", e)


def get_execution_state_cache(cache_path: str) -> GlobalCache:
    if not Path(cache_path).exists():
        init_execution_state_cache(cache_path)
    try:
        return GlobalCache.model_validate_json(Path(cache_path).read_text())
    except Exception:
        return GlobalCache()


def _strip_fences(text: str) -> str:
    text = text.strip()
    if text.startswith("```"):
        segments = text.split("```")
        text = segments[1] if len(segments) > 1 else text
        if text.startswith("json"):
            text = text[4:]
    return text.strip()


def _convert_pdf_page_to_b64_image(doc: fitz.Document, page_num: int, dpi: int) -> str:
    """Convert a PDF page to a base64 PNG. Caller must ensure doc is open."""
    try:
        page = doc[page_num]
        pixmap = page.get_pixmap(dpi=dpi)
        try:
            img_bytes = io.BytesIO(pixmap.tobytes("png"))
            return base64.b64encode(img_bytes.getvalue()).decode("utf-8")
        finally:
            pixmap.close()
    except Exception as e:
        log.error("[FAIL] Failed to convert page %d to image: %s", page_num, e)
        raise


@retry_on_failure(max_retries=3, delay=2.0)
def generate_cluster_checkpoint_summary(cluster_id: int, records: List[Dict], client: OpenAI, model_name: str) -> str:
    if not records:
        return "No extraction records yet."
    sampled = json.dumps([r.get("data", {}).get("tables", []) for r in records[-3:]], indent=2)[:2000]
    prompt = f"Write a concise 2-sentence analytical summary of the kind of data that was just extracted, based on this JSON snippet: {sampled}"
    response = client.chat.completions.create(
        model=model_name,
        messages=[{"role": "user", "content": prompt}],
        temperature=0.2,
        timeout=20
    )
    summary = response.choices[0].message.content.strip()
    return summary


